generator client {
  provider = "prisma-client-js"
}

// Datasource defaults to SQLite for local development. Set DATABASE_URL to a
// PostgreSQL connection string on Render and run `prisma db push` to migrate.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ball {
  id                 Int               @id @default(autoincrement())
  name               String
  nombre             String?
  description        String?
  descripcion        String?
  imageUrl           String?
  type               String?
  isPure             Boolean           @default(false)
  slug               String            @unique
  evolutionsAsBase   Evolution[]       @relation("BaseBall")
  evolutionsAsResult Evolution[]       @relation("ResultBall")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Evolution {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  baseId      Int
  resultId    Int
  description String?
  descripcion String?
  imageUrl    String? 
  baseBall    Ball     @relation("BaseBall", fields: [baseId], references: [id])
  resultBall  Ball     @relation("ResultBall", fields: [resultId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Character {
  id                    Int      @id @default(autoincrement())
  slug                  String   @unique
  nameEn                String
  nameEs                String
  descriptionEn         String?
  descriptionEs         String?
  startingBallEn        String?
  startingBallEs        String?
  unlockRequirementEn   String?
  unlockRequirementEs   String?
  imageUrl              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  nombre      String?
  description String?
  descripcion String?
  imageUrl    String?
  type        String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Passive {
  id             Int      @id @default(autoincrement())
  name_en        String
  name_es        String
  description_en String?
  description_es String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PassiveEvolution {
  id            Int      @id @default(autoincrement())
  components_en String
  components_es String
  result_en     String
  result_es     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
