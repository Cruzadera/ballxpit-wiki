generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ball {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  nombre               String?
  type                 String
  tipo                 String                @default("pura")
  level                Int
  description          String
  descripcion          String?
  imageUrl             String
  fusionResults        FusionRecipe[]        @relation("FusionResult")
  fusionInputs         FusionInput[]
  evolutionResults     Evolution[]           @relation("EvolutionResult")
  evolutionComponents  EvolutionComponent[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model FusionRecipe {
  id            Int           @id @default(autoincrement())
  requiredLevel Int
  origenA       String?
  origenB       String?
  resultado     String?
  descripcion   String?
  emoji         String?
  tipo          String        @default("fusion")
  resultId      Int
  result        Ball          @relation("FusionResult", fields: [resultId], references: [id])
  inputs        FusionInput[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model FusionInput {
  id        Int           @id @default(autoincrement())
  recipeId  Int
  ballId    Int
  recipe    FusionRecipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ball      Ball          @relation(fields: [ballId], references: [id], onDelete: Cascade)
}

model Evolution {
  id            Int                 @id @default(autoincrement())
  requiredLevel Int
  descripcion   String?
  emoji         String?
  tipo          String              @default("evolucion")
  resultId      Int
  result        Ball                @relation("EvolutionResult", fields: [resultId], references: [id])
  components    EvolutionComponent[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model EvolutionComponent {
  id          Int        @id @default(autoincrement())
  evolutionId Int
  ballId      Int
  evolution   Evolution  @relation(fields: [evolutionId], references: [id], onDelete: Cascade)
  ball        Ball       @relation(fields: [ballId], references: [id], onDelete: Cascade)
}

model Character {
  id             Int    @id @default(autoincrement())
  slug           String @unique
  name_es        String
  name_en        String
  short_es       String
  short_en       String
  description_es String
  description_en String
  ball           String
  trait_es       String
  trait_en       String
}
